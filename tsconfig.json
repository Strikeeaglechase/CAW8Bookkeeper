{
	"compilerOptions": {
		"target": "ES2022",
		"strict": false,
		// "moduleResolution": "node16",
		"module": "ES2022",
		"allowSyntheticDefaultImports": true,
		"outDir": "dist/",
		"rootDir": "src/",
		"lib": [
			"ES2022"
		],
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"emitDecoratorMetadata": true,
		"sourceMap": true,
		"skipLibCheck": true
	},
	"include": [
		"src/"
	],
}